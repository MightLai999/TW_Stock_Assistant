              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return (Number(valA) - Number(valB)) * dirMultiplier;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
