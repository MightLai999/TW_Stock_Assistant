        target_content: "const PYTHON_SNIPPET = `import json\n\n# \346\257\217\346\227\245\347\224\261\347\210\254\350\237\262\346\210\226\345\210\270\345\225\206 API \345\275\231\346\225\264\345\276\214\357\274\214\347\233\264\346\216\245\350\246\206\345\257\253 public/stocks.json\357\274\210\346\210\226\351\203\250\347\275\262\347\233\256\351\214\204\347\232\204 stocks.json\357\274\211\nstocks = [\n    {\n        \"code\": \"2330\",\n        \"name\": \"\345\217\260\347\251\215\351\233\273\",\n        \"cashDividend\": 18.0,\n        \"exDividendDate\": \"2026/06/18\",\n        \"stockDividend\": 0.0,\n        \"exRightsDate\": \"-\",\n        \"price\": 1035.0,\n        \"cashYield\": 1.74,\n        \"totalYield\": 1.74,\n        \"payDate\": \"2026/07/16\",\n        \"payoutRatio\": 39.78,\n        \"insiderHolding\": 6.42,\n        \"avgDiv3Y\": 14.33,\n        \"avgDiv6Y\": 12.17,\n        \"avgDiv10Y\": 10.35,\n        \"divCount10Y\": 10,\n        \"epsQ1\": 13.94,\n        \"epsQ2\": 14.82,\n        \"epsQ3\": 15.65,\n        \"epsYTD\": 44.41,\n        \"epsLastYear\": 45.25,\n        \"peRatio\": 22.87,\n        \"pbRatio\": 6.45\n    }\n]\n\nwith open(\"public/stocks.json\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(stocks, f, ensure_ascii=False, indent=2)\n`;"
        replacement_content: "const PYTHON_SNIPPET = `import json\nimport requests\n\n# 1. \345\276\236\350\207\272\347\201\243\350\255\211\345\210\270\344\272\244\346\230\223\346\211\200 OpenAPI \346\212\223\345\217\226\346\234\200\346\226\260\346\257\217\346\227\245\346\224\266\347\233\244\345\203\271\350\210\207\346\234\254\347\233\212\346\257\224\357\274\217\346\267\250\345\200\274\346\257\224\nday_all = requests.get(\"https://openapi.twse.com.tw/v1/exchangeReport/STOCK_DAY_ALL\", timeout=15).json()\nbwibbu = requests.get(\"https://openapi.twse.com.tw/v1/exchangeReport/BWIBBU_ALL\", timeout=15).json()\n\nprice_map = {r[\"Code\"]: float(r[\"ClosingPrice\"]) for r in day_all if r.get(\"ClosingPrice\")}\nval_map = {r[\"Code\"]: r for r in bwibbu}\n\n# 2. \347\265\220\345\220\210 FinMind / MOPS \345\255\243\345\240\261 EPS \350\210\207\350\202\241\345\210\251\350\263\207\346\226\231\345\276\214\357\274\214\350\274\270\345\207\272\347\202\272 23 \346\254\204\344\275\215\346\250\231\346\272\226\346\240\274\345\274\217\nstocks = [\n    {\n        \"code\": \"2454\",\n        \"name\": \"\350\201\257\347\231\274\347\247\221\",\n        \"cashDividend\": 53.5,\n        \"exDividendDate\": \"2026/07/07\",\n        \"stockDividend\": 0.0,\n        \"exRightsDate\": \"-\",\n        \"price\": price_map.get(\"2454\", 3780.0),\n        \"cashYield\": round(53.5 / price_map.get(\"2454\", 3780.0) * 100, 2),\n        \"totalYield\": round(53.5 / price_map.get(\"2454\", 3780.0) * 100, 2),\n        \"payDate\": \"2026/07/31\",\n        \"payoutRatio\": 80.86,\n        \"insiderHolding\": 5.72,\n        \"avgDiv3Y\": 54.17,\n        \"avgDiv6Y\": 53.08,\n        \"avgDiv10Y\": 38.65,\n        \"divCount10Y\": 10,\n        \"epsQ1\": 15.17,\n        \"epsQ2\": 15.28,\n        \"epsQ3\": 17.50,\n        \"epsYTD\": 47.95,\n        \"epsLastYear\": 66.16,\n        \"peRatio\": float(val_map.get(\"2454\", {}).get(\"PEratio\") or 60.63),\n        \"pbRatio\": float(val_map.get(\"2454\", {}).get(\"PBratio\") or 13.45),\n    }\n]\n\nwith open(\"public/stocks.json\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(stocks, f, ensure_ascii=False, indent=2)\n`;"
        start_line: 14
