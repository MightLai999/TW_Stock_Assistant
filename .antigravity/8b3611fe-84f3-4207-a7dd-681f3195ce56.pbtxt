    summary: "\344\273\245\344\270\213\347\202\272\346\202\250\346\225\264\347\220\206 **\344\270\255\350\217\257\351\233\273 (2412)**\343\200\201**\347\265\261\344\270\200 (1216)**\343\200\201**\351\225\267\346\246\256 (2603)** \344\270\211\346\252\224\345\200\213\350\202\241\345\234\250 **2026\345\271\264\345\211\215\344\270\211\345\255\243\357\274\210Q1\343\200\201Q2\343\200\201Q3\357\274\211\344\271\213 EPS\343\200\201\350\277\221\346\234\237\350\202\241\345\203\271\343\200\201\346\234\254\347\233\212\346\257\224\343\200\201\350\202\241\345\203\271\346\267\250\345\200\274\346\257\224\344\273\245\345\217\212\350\221\243\347\233\243\346\214\201\350\202\241** \347\255\211\347\233\270\351\227\234\350\262\241\345\213\231\350\210\207\347\261\214\347\242\274\350\263\207\350\250\212\357\274\232\n\n---\n\n### 1. \344\270\255\350\217\257\351\233\273 (2412) \342\200\224 \351\233\273\344\277\241\350\202\241\n* **2026 \345\220\204\345\255\243 EPS\357\274\232**\n  * **2026 Q1\357\274\232** 1.30 \345\205\203[1]\n  * **2026 Q2\357\274\232** 1.37 \345\205\203[1]\n  * **2026 Q3\357\274\232** 1.58 \345\205\203[1]\n  * *\357\274\2102026 \345\211\215\344\270\211\345\255\243\347\264\257\350\250\210 EPS \347\264\204 4.25 \345\205\203\357\274\211*[1]\n* **\350\277\221\346\234\237\350\202\241\345\203\271\357\274\232** \347\264\204\345\234\250 **164 \357\275\236 165 \345\205\203**\345\267\246\345\217\263[2]\343\200\202\n* **\346\234\254\347\233\212\346\257\224 (P/E)\357\274\232** \347\264\204 **30 ~ 31 \345\200\215**\344\270\212\344\270\213\357\274\210\345\261\254\351\230\262\345\256\210\345\236\213\351\253\230\350\251\225\345\203\271\345\215\200\351\226\223\357\274\211[3][2]\343\200\202\n* **\350\202\241\345\203\271\346\267\250\345\200\274\346\257\224 (P/B)\357\274\232** \347\264\204 **3.37 ~ 3.46 \345\200\215**[1][4]\357\274\210\346\257\217\350\202\241\346\267\250\345\200\274\347\264\204\345\234\250 48.75 \345\205\203\345\267\246\345\217\263\357\274\211[5]\343\200\202\n* **\350\221\243