  code_action {
    action_spec {
      create_file {
        instruction: "@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \"Plus Jakarta Sans\", \"Noto Sans TC\", \"Microsoft JhengHei\", system-ui, -apple-system, sans-serif;\n  --font-mono: \"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n}\n\n@layer base {\n  html,\n  body {\n    font-family: var(--font-sans);\n    color: #0f172a;\n    background-color: #f5f7fa;\n  }\n\n  /* Subtle, crisp scrollbars for wide financial data grids */\n  .table-scroll::-webkit-scrollbar {\n    width: 10px;\n    height: 10px;\n  }\n\n  .table-scroll::-webkit-scrollbar-track {\n    background: #f1f5f9;\n  }\n\n  .table-scroll::-webkit-scrollbar-thumb {\n    background: #cbd5e1;\n    border: 2px solid #f1f5f9;\n    border-radius: 6px;\n  }\n\n  .table-scroll::-webkit-scrollbar-thumb:hover {\n    background: #94a3b8;\n  }\n}\n\n.tabular-nums {\n  font-variant-numeric: tabular-nums;\n}\n"
        path {
          absolute_uri: "file:///src/index.css"
        }
        overwrite: true
      }
    }
