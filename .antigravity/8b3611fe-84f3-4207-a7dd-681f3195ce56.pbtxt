    summary: "\344\273\245\344\270\213\347\202\272\345\217\260\350\202\241 IC \350\250\255\350\250\210\351\276\215\351\240\255 **\350\201\257\347\231\274\347\247\221\357\274\2102454\357\274\211** \346\210\252\350\207\263 2026 \345\271\264 11 \346\234\210\347\232\204\351\227\234\351\215\265\350\262\241\345\213\231\350\210\207\345\270\202\345\240\264\346\225\270\346\223\232\347\270\275\350\246\275\357\274\232\n\n### 1. 2025 \345\271\264 EPS\357\274\210\346\257\217\350\202\241\347\233\210\351\244\230\357\274\211\n* **2025 \345\205\250\345\271\264 EPS**\357\274\232**66.16 \345\205\203**\357\274\210\345\205\250\345\271\264\345\220\210\344\275\265\347\207\237\346\224\266\351\201\224 5,959.6 \345\204\204\345\205\203\357\274\214\345\271\264\345\242\236 12.3%\357\274\214\347\250\205\345\276\214\347\264\224\347\233\212\351\201\224 1,061.1 \345\204\204\345\205\203\357\274\214\345\211\265\344\270\213\346\255\267\345\217\262\346\226\260\351\253\230\347\264\200\351\214\204\357\274\211[1]\343\200\202\n\n### 2. \344\274\260\345\200\274\346\214\207\346\250\231\357\274\210\346\234\254\347\233\212\346\257\224\350\210\207\350\202\241\345\203\271\346\267\250\345\200\274\346\257\224\357\274\211\n*(\344\273\245 2026 \345\271\264 11 \346\234\210\344\270\255\346\227\254\350\202\241\345\203\271\347\264\204\345\234\250 3,720 ~ 3,840 \345\205\203\345\267\246\345\217\263\345\215\200\351\226\223\350\250\210\347\256\227)*\n* **\346\234\254\347\233\212\346\257\224\357\274\210P/E\357\274\211**\357\274\232\347\264\204 **55 ~ 61 \345\200\215** \345\267\246\345\217\263\346\263\242\345\213\225\357\274\210\345\233\240\345\217\227\345\270\202\345\240\264\345\260\215 AI \345\217\212\351\253\230\351\232\216\346\231\266\347\211\207\350\251\225\345\203\271\350\252\277\347\257\200\350\200\214\350\256\212\345\213\225\357\274\211[2][3]\343\200\202\n* **\350\202\241\345\203\271\346\267\250\345\200\274\346\257\224\357\274\210P/B\357\274\211**\357\274\232\347\264\204 **12.8 ~ 14.5 \345\200\215** \345\267\246\345\2