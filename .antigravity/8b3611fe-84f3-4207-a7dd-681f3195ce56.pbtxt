    summary: "\344\273\245\344\270\213\347\202\272\345\217\260\350\202\241 IC \350\250\255\350\250\210\345\244\247\345\273\240**\350\201\257\350\251\240\357\274\2103034\357\274\211**\345\234\250 2026 \345\271\264\347\233\270\351\227\234\347\232\204\350\202\241\345\210\251\351\205\215\346\201\257\343\200\201\350\202\241\345\203\271\350\210\207\350\262\241\345\213\231\350\251\225\345\203\271\346\214\207\346\250\231\350\263\207\350\250\212\357\274\232\n\n### 1. 2026 \345\271\264\351\205\215\346\201\257\350\263\207\350\250\212\n* **\347\217\276\351\207\221\350\202\241\345\210\251**\357\274\232\346\257\217\350\202\241\351\205\215\347\231\274 **23.00 \345\205\203**\357\274\210\345\237\272\346\226\274 2025 \345\271\264\347\233\210\351\244\230\345\210\206\351\205\215\357\274\211[1][2]\n* **\351\231\244\346\201\257\344\272\244\346\230\223\346\227\245**\357\274\232**2026 \345\271\264 7 \346\234\210 10 \346\227\245**[3]\n* **\347\217\276\351\207\221\350\202\241\345\210\251\347\231\274\346\224\276\346\227\245**\357\274\232**2026 \345\271\264 8 \346\234\210 11 \346\227\245**[3]\n* **\351\231\244\346\201\257\345\217\203\350\200\203\345\203\271**\357\274\232\347\264\204 542 \345\205\203[4]\n\n---\n\n### 2. 2026 \345\271\264 11 \346\234\210\346\234\200\346\226\260\345\270\202\345\240\264\350\210\207\350\262\241\345\213\231\346\214\207\346\250\231\n*(\350\250\273\357\274\232\345\217\260\350\202\241\346\225\270\346\223\232\351\232\250\346\257\217\346\227\245\347\233\244\345\213\242\350\256\212\345\213\225\357\274\214\344\273\245\344\270\213\347\202\272 2026 \345\271\264 11 \346\234\210\344\270\255\344\270\213\346\227\254\345\217\203\350\200\203\346\225\270\346\223\232)*\n\n* **\350\202\241\345\203\271\350\241\250\347\217\276**\357\274\232\345\244\247\347\264\204\350\220\275\345\234\250 **430 ~ 470 \345\205\203** \345\267\246\345\217\263\351\234\207\347\233\252\357\274\21011\346\234\210\344\270\255\346\227\254\346\224\266\347\233\244\345\203\271\347\264\204\345\234\250 436.5 \350\207\