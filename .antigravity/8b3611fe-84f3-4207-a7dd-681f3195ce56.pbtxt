    summary: "\344\273\245\344\270\213\347\202\272\346\202\250\346\225\264\347\220\206 2026 \345\271\264\344\270\255\344\277\241\351\207\221\343\200\201\347\265\261\344\270\200\345\217\212\351\225\267\346\246\256\347\233\270\351\227\234\345\255\243\345\272\246\347\232\204\345\226\256\345\255\243 EPS \346\225\270\346\223\232\357\274\232\n\n### 1. \343\200\2142891\343\200\215\344\270\255\344\277\241\351\207\221 2026 \345\271\264 Q1\343\200\201Q2\343\200\201Q3 \345\226\256\345\255\243 EPS\n* **2026 Q1\357\274\232** 1.18 \345\205\203[1]\n* **2026 Q2\357\274\232** 0.78 \345\205\203[1]\n* **2026 Q3\357\274\232** \357\274\210\350\250\273\357\274\232\344\270\255\344\277\241\351\207\221\346\216\241\351\207\221\346\216\247\346\205\243\344\276\213\357\274\214\347\254\254\344\270\211\345\255\243\345\256\214\346\225\264\350\262\241\345\240\261\350\210\207\346\225\270\346\223\232\351\200\232\345\270\270\346\226\274 11 \346\234\210\344\270\255\346\227\254\351\231\270\347\272\214\345\272\225\345\256\232\345\205\254\344\275\210\357\274\214\345\205\266\347\264\257\350\250\210\345\211\215\345\215\201\346\234\210 EPS \347\202\272 3.45 \345\205\203[2]\357\274\214\345\220\253\346\254\212\347\233\212\345\267\245\345\205\267\350\231\225\345\210\206\345\210\251\347\233\212\344\271\213\347\264\257\350\250\210 EPS \345\211\207\347\202\272 7.57 \345\205\203[2]\357\274\211\n\n---\n\n### 2. \343\200\2141216\343\200\215\347\265\261\344\270\200 2026 \345\271\264 Q1\343\200\201Q2\343\200\201Q3 \345\226\256\345\255\243 EPS\n* **2026 Q1\357\274\232** 1.15 \345\205\203[3]\n* **2026 Q2\357\274\232** 1.41 \345\205\203[3]\n* **2026 Q3\357\274\232** 1.14 \345\205\203[3]\n*(\347\264\257\350\250\210\345\211\215\344\270\211\345\255\243 EPS \345\205\261\350\250\210 3.70 \345\205\203)[4]*\n\n---\n\n### 3. \343\200\2142603\343\200\215\351\225\267\346\246\256 2026 \345\271\264 Q2 EPS\n* **2026 Q2\357\274\232** **7.41 \345\205\203**[5] \n*(\350\243\234\345\205\205\357\274\232\345\205\266 2026Q1 \345\226\256\345\2