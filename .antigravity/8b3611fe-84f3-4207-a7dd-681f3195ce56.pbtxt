  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { Download, RotateCcw, Search, SlidersHorizontal } from \'lucide-react\';\nimport { FILTER_PRESETS } from \'../data/stocksData\';\nimport { NumericFilterCriteria } from \'../types/stock\';\n\ninterface FilterPanelProps {\n  keyword: string;\n  onKeywordChange: (value: string) => void;\n  draftFilters: NumericFilterCriteria;\n  onDraftChange: (field: keyof NumericFilterCriteria, value: string) => void;\n  hasUnappliedChanges: boolean;\n  activeFilterCount: number;\n  activePresetId: string | null;\n  onApplyPreset: (presetId: string) => void;\n  onApplyFilters: () => void;\n  onResetFilters: () => void;\n  onExportCsv: () => void;\n  resultCount: number;\n}\n\ninterface NumericFieldSpec {\n  key: keyof Omit<NumericFilterCriteria, \'exDividendMonth\'>;\n  label: string;\n  operator: \'>=\' | \'<=\';\n  unit: string;\n  placeholder: string;\n  step: string;\n}\n\nconst NUMERIC_FIELDS: NumericFieldSpec[] = [\n  {\n    key: \'minCashYield\',\n    label: \'\347\217\276\351\207\221\346\256\226\345\210\251\347\216\207\',\n    operator: \'>=\',\n    unit: \'%\',\n    placeholder: \'\344\276\213 5\',\n    step: \'0.1\',\n  },\n  {\n    key: \'minTotalYield\',\n    label: \'\345\220\210\350\250\210\346\256\226\345\210\251\347\216\207\',\n    operator: \'>=\',\n    unit: \'%\',\n    placeholder: \'\344\276\213 5\',\n    step: \'0.1\',\n  },\n  {\n    key: \'minDivCount10Y\',\n    label: \'10\345\271\264\350\202\241\345\210\251\346\254\241\346\225\270\',\n    operator: \'>=\',\n    unit: \'\346\254\241\',\n    placeholder: \'\344\276\213 10\',\n    step: \'1\',\n  },\n  {\n    key: \'minAvgDiv10Y\',\n    label: \'10\345\271\264\345\271\263\345\235\207\350\202\241\345\210\251\',\n    operator: \'>=\',\n    unit: \'\345\205\203\',\n    placeholder: \'\344\276\213 1.5\',\n    step: \'0.1\',\n  },\n  {\n    key: \'maxPeRatio\',\n    label: \'\346\234\254\347\233\212\346\257\224\',\n    operator: \'<=\',\n    unit: \'\345\200\215\',\n    placeholder: \'\344\276\213 18\',\n    step: \'0.5\',\n  },\n  {\n    key: \'maxPbRatio\',\n    label: \'\350\202\241\345\203\271\346\267\250\345\200\274\346\257\224\',\n    operator: \'<=\',\n    unit: \'\345\200\215\',\n    placeholder: \'\344\276\213 2\',\n    step: \'0.1\',\n  },\n  {\n    key: \'minInsiderHolding\',\n    label: \'\350\221\243\347\233\243\346\214\201\350\202\241\',\n    operator: \'>=\',\n    unit: \'%\',\n    placeholder: \'\344\276\213 10\',\n    step: \'0.5\',\n  },\n];\n\nconst MONTHS = Array.from({ length: 12 }, (_, idx) => idx + 1);\n\nexport const FilterPanel: React.FC<FilterPanelProps> = ({\n  keyword,\n  onKeywordChange,\n  draftFilters,\n  onDraftChange,\n  hasUnappliedChanges,\n  activeFilterCount,\n  activePresetId,\n  onApplyPreset,\n  onApplyFilters,\n  onResetFilters,\n  onExportCsv,\n  resultCount,\n}) => {\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    onApplyFilters();\n  };\n\n  return (\n    <section\n      aria-label=\"\345\244\232\346\242\235\344\273\266\350\244\207\345\220\210\347\257\251\351\201\270\351\235\242\346\235\277\"\n      className=\"bg-white border border-slate-200 rounded-lg px-4 py-3.5\"\n    >\n      <form onSubmit={handleSubmit} className=\"space-y-3\">\n        {/* Top Row: Instant Keyword Search + Quick Presets */}\n        <div className=\"flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3\">\n          <div className=\"relative flex-1 max-w-md\">\n            <Search\n              className=\"w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\"\n              aria-hidden=\"true\"\n            />\n            <input\n              type=\"text\"\n              value={keyword}\n              onChange={(e) => onKeywordChange(e.target.value)}\n              placeholder=\"\350\274\270\345\205\245\344\273\243\350\231\237\346\210\226\345\205\254\345\217\270\345\220\215\347\250\261\345\215\263\346\231\202\351\201\216\346\277\276\357\274\210\344\276\213\357\274\2322330\343\200\201\351\207\221\343\200\201\351\253\230\350\202\241\346\201\257\357\274\211\"\n              aria-label=\"\351\227\234\351\215\265\345\255\227\346\220\234\345\260\213\344\273\243\350\231\237\346\210\226\345\205\254\345\217\270\345\220\215\347\250\261\"\n              className=\"w-full h-9 pl-9 pr-8 text-sm bg-slate-50 border border-slate-300 rounded-md text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1B365D]/20 focus:border-[#1B365D] transition-colors\"\n            />\n            {keyword && (\n              <button\n                type=\"button\"\n                onClick={() => onKeywordChange(\'\')}\n                aria-label=\"\346\270\205\351\231\244\346\220\234\345\260\213\351\227\234\351\215\265\345\255\227\"\n                className=\"absolute right-2 top-1/2 -translate-y-1/2 w-5 h-5 flex items-center justify-center text-slate-400 hover:text-slate-700 text-xs font-semibold rounded\"\n              >\n                \303\227\n              </button>\n            )}\n          </div>\n\n          <div\n            className=\"flex items-center gap-1 overflow-x-auto bg-slate-100 p-1 rounded-md\"\n            role=\"group\"\n            aria-label=\"\345\270\270\347\224\250\347\257\251\351\201\270\347\255\226\347\225\245\"\n          >\n            {FILTER_PRESETS.map((preset) => {\n              const isActive = activePresetId === preset.id;\n              return (\n                <button\n                  key={preset.id}\n                  type=\"button\"\n                  onClick={() => onApplyPreset(preset.id)}\n                  className={`px-2.5 py-1 text-xs font-medium rounded whitespace-nowrap shrink-0 transition-colors cursor-pointer ${\n                    isActive\n                      ? \'bg-white text-[#1B365D] shadow-xs\'\n                      : \'text-slate-600 hover:text-slate-900\'\n                  }`}\n                >\n                  {preset.label}\n                </button>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Middle Row: 8 Composite Filter Inputs */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-4 xl:grid-cols-8 gap-2.5 pt-2.5 border-t border-slate-100\">\n          {NUMERIC_FIELDS.map((field) => (\n            <label key={field.key} className=\"block\">\n              <span className=\"flex items-center justify-between text-xs font-medium text-slate-600 mb-1 whitespace-nowrap\">\n                <span>{field.label}</span>\n                <span className=\"font-mono text-[11px] text-slate-400\">{field.operator}</span>\n              </span>\n              <div className=\"relative flex items-center\">\n                <input\n                  type=\"number\"\n                  step={field.step}\n                  min=\"0\"\n                  value={draftFilters[field.key]}\n                  onChange={(e) => onDraftChange(field.key, e.target.value)}\n                  placeholder={field.placeholder}\n                  className=\"w-full h-8 pl-2.5 pr-7 text-xs font-mono tabular-nums bg-white border border-slate-300 rounded text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#1B365D]/20 focus:border-[#1B365D] transition-colors\"\n                />\n                <span className=\"absolute right-2 text-[11px] text-slate-400 pointer-events-none select-none\">\n                  {field.unit}\n                </span>\n              </div>\n            </label>\n          ))}\n\n          {/* Ex-Dividend Month Dropdown */}\n          <label className=\"block\">\n            <span className=\"flex items-center justify-between text-xs font-medium text-slate-600 mb-1 whitespace-nowrap\">\n              <span>\351\231\244\346\201\257\346\234\210\344\273\275</span>\n              <span className=\"text-[11px] text-slate-400\">\346\234\210</span>\n            </span>\n            <select\n              value={draftFilters.exDividendMonth}\n              onChange={(e) => onDraftChange(\'exDividendMonth\', e.target.value)}\n              aria-label=\"\351\231\244\346\201\257\346\234\210\344\273\275\"\n              className=\"w-full h-8 px-2 text-xs bg-white border border-slate-300 rounded text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#1B365D]/20 focus:border-[#1B365D] transition-colors cursor-pointer\"\n            >\n              <option value=\"\">\345\205\250\351\203\250\346\234\210\344\273\275</option>\n              {MONTHS.map((m) => (\n                <option key={m} value={String(m)}>\n                  {m}\346\234\210\n                </option>\n              ))}\n            </select>\n          </label>\n        </div>\n\n        {/* Bottom Action Row */}\n        <div className=\"flex flex-wrap items-center justify-between gap-3 pt-2.5 border-t border-slate-100\">\n          <div className=\"flex flex-wrap items-center gap-2 text-xs text-slate-500\">\n            <span>\n              {activeFilterCount > 0\n                ? `\347\233\256\345\211\215\345\267\262\345\225\237\347\224\250 ${activeFilterCount} \351\240\205\347\257\251\351\201\270\346\242\235\344\273\266`\n                : \'\345\260\232\346\234\252\350\250\255\345\256\232\346\225\270\345\200\274\346\210\226\346\234\210\344\273\275\347\257\251\351\201\270\346\242\235\344\273\266\'}\n            </span>\n            {hasUnappliedChanges && (\n              <>\n                <span aria-hidden=\"true\">\302\267</span>\n                <span className=\"text-amber-700 font-medium\">\n                  \346\242\235\344\273\266\345\267\262\344\277\256\346\224\271\357\274\214\350\253\213\346\214\211\343\200\214\345\245\227\347\224\250\347\257\251\351\201\270\343\200\215\346\210\226 Enter \346\233\264\346\226\260\350\241\250\346\240\274\n                </span>\n              </>\n            )}\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-2\">\n            <button\n              type=\"submit\"\n              className=\"inline-flex items-center gap-1.5 h-9 px-4 text-xs font-semibold text-white bg-[#1B365D] hover:bg-[#132847] rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B365D]\"\n            >\n              <SlidersHorizontal className=\"w-3.5 h-3.5\" aria-hidden=\"true\" />\n              <span>\345\245\227\347\224\250\347\257\251\351\201\270</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={onResetFilters}\n              className=\"inline-flex items-center gap-1.5 h-9 px-3.5 text-xs font-medium text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-400\"\n            >\n              <RotateCcw className=\"w-3.5 h-3.5\" aria-hidden=\"true\" />\n              <span>\346\270\205\351\231\244\346\242\235\344\273\266</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={onExportCsv}\n              disabled={resultCount === 0}\n              className=\"inline-flex items-center gap-1.5 h-9 px-3.5 text-xs font-medium text-slate-800 bg-slate-100 border border-slate-300 hover:bg-slate-200/80 disabled:opacity-45 disabled:cursor-not-allowed rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-500\"\n            >\n              <Download className=\"w-3.5 h-3.5\" aria-hidden=\"true\" />\n              <span>\345\214\257\345\207\272\347\233\256\345\211\215\347\265\220\346\236\234\347\202\272 CSV</span>\n            </button>\n          </div>\n        </div>\n      </form>\n    </section>\n  );\n};\n"
