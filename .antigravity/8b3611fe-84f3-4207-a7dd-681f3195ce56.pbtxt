: \'right\', minWidth: \'min-w-[88px]\', decimals: 2 },\n  { key: \'peRatio\', label: \'\346\234\254\347\233\212\346\257\224\', type: \'number\', align: \'right\', minWidth: \'min-w-[82px]\', decimals: 2 },\n  { key: \'pbRatio\', label: \'\350\202\241\345\203\271\346\267\250\345\200\274\346\257\224\', type: \'number\', align: \'right\', minWidth: \'min-w-[102px]\', decimals: 2 },\n];\n\nexport const EMPTY_FILTERS: NumericFilterCriteria = {\n  minCashYield: \'\',\n  minTotalYield: \'\',\n  minDivCount10Y: \'\',\n  minAvgDiv10Y: \'\',\n  maxPeRatio: \'\',\n  maxPbRatio: \'\',\n  minInsiderHolding: \'\',\n  exDividendMonth: \'\',\n};\n\nexport interface FilterPreset {\n  id: string;\n  label: string;\n  criteria: NumericFilterCriteria;\n}\n\nexport const FILTER_PRESETS: FilterPreset[] = [\n  {\n    id: \'all\',\n    label: \'\345\205\250\351\203\250\346\250\231\347\232\204\',\n    criteria: { ...EMPTY_FILTERS },\n  },\n  {\n    id: \'high-yield-5\',\n    label: \'\347\217\276\351\207\221\346\256\226\345\210\251\347\216\207 5% \344\273\245\344\270\212\',\n    criteria: { ...EMPTY_FILTERS, minCashYield: \'5\' },\n  },\n  {\n    id: \'steady-10y\',\n    label: \'10\345\271\264\351\200\243\347\272\214\351\205\215\346\201\257\357\274\213\345\220\210\350\250\210\346\256\226\345\210\251\347\216\207 4%+\',\n    criteria: { ...EMPTY_FILTERS, minTotalYield: \'4\', minDivCount10Y: \'10\' },\n  },\n  {\n    id: \'value-low-pe\',\n    label: \'\344\275\216\346\234\254\347\233\212\346\257\224\345\203\271\345\200\274\350\202\241 (PE \342\211\244 17)\',\n    criteria: { ...EMPTY_FILTERS, minTotalYield: \'4\', maxPeRatio: \'17\', maxPbRatio: \'2\' },\n  },\n  {\n    id: \'july-ex\',\n    label: \'7\346\234\210\351\231\244\346\201\257\350\202\241\',\n    criteria: { ...EMPTY_FILTERS, exDividendMonth: \'7\' },\n  },\n];\n\nexport function extractMonthFromDate(dateStr: string): number | null {\n  if (!dateStr || dateStr === \'-\') return null;\n  const match = dateStr.match(/^\\d{4}[/-](\\d{1,2})[/-]\\d{1,2}$/);\n  if (!match) return null;\n  const month = Number.parseInt(match[1], 10);\n  return Number.isNaN(month) ? null : month;\n}\n\nexport function formatCellValue(record: StockRecord, col: ColumnDefinition): string {\n  const value = record[col.key];\n  if (value === null || value === undefined || value === \'\') {\n    return \'-\';\n  }\n  if (col.type === \'code\' || col.type === \'text\' || col.type === \'date\') {\n    return String(value);\n  }\n  const num = Number(value);\n  if (Number.isNaN(num)) return \'-\';\n  if (col.type === \'integer\') {\n    return `${Math.round(num)}`;\n  }\n  if (col.type === \'percent\') {\n    return `${num.toFixed(col.decimals ?? 2)}%`;\n  }\n  return num.toFixed(col.decimals ?? 2);\n}\n\nexport function exportStocksToCsv(rows: StockRecord[]): void {\n  const escapeCsv = (val: string) => {\n    if (/[\",\\n\\r]/.test(val)) {\n      return `\"${val.replace(/\"/g, \'\"\"\')}\"`;\n    }\n    return val;\n  };\n\n  const headerLine = TABLE_COLUMNS.map((c) => escapeCsv(c.label)).join(\',\');\n  const dataLines = rows.map((row) =>\n    TABLE_COLUMNS.map((col) => escapeCsv(formatCellValue(row, col))).join(\',\')\n  );\n\n  // Prefix UTF-8 BOM so Microsoft Excel renders Traditional Chinese cleanly\n  const csvContent = \'\\uFEFF\' + [headerLine, ...dataLines].join(\'\\r\\n\');\n  const blob = new Blob([csvContent], { type: \'text/csv;charset=utf-8;\' });\n  const url = URL.createObjectURL(blob);\n\n  const now = new Date();\n  const y = now.getFullYear();\n  const m = String(now.getMonth() + 1).padStart(2, \'0\');\n  const d = String(now.getDate()).padStart(2, \'0\');\n\n  const link = document.createElement(\'a\');\n  link.href = url;\n  link.download = `\345\217\260\350\202\241\346\256\226\345\210\251\347\216\207\347\257\251\351\201\270_${y}${m}${d}.csv`;\n  document.body.appendChild(link);\n  link.click();\n  document.body.removeChild(link);\n  URL.revokeObjectURL(url);\n}\n"
