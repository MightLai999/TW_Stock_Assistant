  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useRef, useState } from \'react\';\nimport { Check, Copy, FileJson, RefreshCw, Upload, X } from \'lucide-react\';\nimport { StockRecord } from \'../types/stock\';\n\ninterface DataGuideModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  dataSourceLabel: string;\n  recordCount: number;\n  onLoadCustomData: (records: StockRecord[], filename: string) => void;\n  onReloadDefaultJson: () => void;\n}\n\nconst PYTHON_SNIPPET = `import json\n\n# \346\257\217\346\227\245\347\224\261\347\210\254\350\237\262\346\210\226\345\210\270\345\225\206 API \345\275\231\346\225\264\345\276\214\357\274\214\347\233\264\346\216\245\350\246\206\345\257\253 public/stocks.json\357\274\210\346\210\226\351\203\250\347\275\262\347\233\256\351\214\204\347\232\204 stocks.json\357\274\211\nstocks = [\n    {\n        \"code\": \"2330\",\n        \"name\": \"\345\217\260\347\251\215\351\233\273\",\n        \"cashDividend\": 18.0,\n        \"exDividendDate\": \"2026/06/18\",\n        \"stockDividend\": 0.0,\n        \"exRightsDate\": \"-\",\n        \"price\": 1035.0,\n        \"cashYield\": 1.74,\n        \"totalYield\": 1.74,\n        \"payDate\": \"2026/07/16\",\n        \"payoutRatio\": 39.78,\n        \"insiderHolding\": 6.42,\n        \"avgDiv3Y\": 14.33,\n        \"avgDiv6Y\": 12.17,\n        \"avgDiv10Y\": 10.35,\n        \"divCount10Y\": 10,\n        \"epsQ1\": 13.94,\n        \"epsQ2\": 14.82,\n        \"epsQ3\": 15.65,\n        \"epsYTD\": 44.41,\n        \"epsLastYear\": 45.25,\n        \"peRatio\": 22.87,\n        \"pbRatio\": 6.45\n    }\n]\n\nwith open(\"public/stocks.json\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(stocks, f, ensure_ascii=False, indent=2)\n`;\n\nexport const DataGuideModal: React.FC<DataGuideModalProps> = ({\n  isOpen,\n  onClose,\n  dataSourceLabel,\n  recordCount,\n  onLoadCustomData,\n  onReloadDefaultJson,\n}) => {\n  const fileInputRef = useRef<HTMLInputElement>(null);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n  const [copied, setCopied] = useState(false);\n\n  if (!isOpen) return null;\n\n  const handleFileChange = async (e: React.ChangeEvent<HTMLInputElement>) => {\n    setErrorMsg(null);\n    const file = e.target.files?.[0];\n    if (!file) return;\n\n    try {\n      const text = await file.text();\n      const parsed = JSON.parse(text);\n      if (!Array.isArray(parsed) || parsed.length === 0) {\n        setErrorMsg(\'JSON \345\205\247\345\256\271\345\277\205\351\240\210\347\202\272\351\235\236\347\251\272\347\232\204\351\231\243\345\210\227\357\274\210Array\357\274\211\346\240\274\345\274\217\343\200\202\');\n        return;\n      }\n      const valid = parsed.every(\n        (item) => item && typeof item.code === \'string\' && typeof item.name === \'string\'\n      );\n      if (!valid) {\n        setErrorMsg(\'\346\257\217\347\255\206\350\263\207\346\226\231\350\207\263\345\260\221\351\234\200\345\214\205\345\220\253\345\255\227\344\270\262\351\241\236\345\236\213\347\232\204 code\357\274\210\344\273\243\350\231\237\357\274\211\350\210\207 name\357\274\210\345\205\254\345\217\270\357\274\211\346\254\204\344\275\215\343\200\202\');\n        return;\n      }\n      onLoadCustomData(parsed as StockRecord[], file.name);\n      onClose();\n    } catch {\n      setErrorMsg(\'\347\204\241\346\263\225\350\247\243\346\236\220 JSON \346\252\224\346\241\210\357\274\214\350\253\213\347\242\272\350\252\215\346\240\274\345\274\217\346\230\257\345\220\246\346\255\243\347\242\272\357\274\210UTF-8 \347\267\250\347\242\274\357\274\211\343\200\202\');\n    } finally {\n      if (fileInputRef.current) {\n        fileInputRef.current.value = \'\';\n      }\n    }\n  };\n\n  const handleCopySnippet = async () => {\n    try {\n      await navigator.clipboard.writeText(PYTHON_SNIPPET);\n      setCopied(true);\n      setTimeout(() => setCopied(false), 1800);\n    } catch {\n      setCopied(false);\n    }\n  };\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 flex items-center justify-center bg-slate-900/45 p-4\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"data-guide-title\"\n    >\n      <div className=\"bg-white border border-slate-200 rounded-lg w-full max-w-2xl max-h-[88vh] flex flex-col shadow-xl overflow-hidden\">\n        <div className=\"flex items-center justify-between px-5 py-3.5 border-b border-slate-200\">\n          <div className=\"flex items-center gap-2\">\n            <FileJson className=\"w-4 h-4 text-[#1B365D]\" aria-hidden=\"true\" />\n            <h2 id=\"data-guide-title\" className=\"text-sm font-bold text-slate-900\">\n              JSON \350\263\207\346\226\231\344\276\206\346\272\220\350\210\207 Python \346\257\217\346\227\245\350\207\252\345\213\225\346\233\264\346\226\260\350\252\252\346\230\216\n            </h2>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            aria-label=\"\351\227\234\351\226\211\350\246\226\347\252\227\"\n            className=\"w-8 h-8 flex items-center justify-center text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded cursor-pointer\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        <div className=\"p-5 overflow-y-auto space-y-5 text-xs text-slate-700\">\n          {/* Current Source & Local Preview Upload */}\n          <div className=\"space-y-2.5\">\n            <div className=\"flex flex-wrap items-center justify-between gap-2\">\n              <div className=\"text-slate-600\">\n                \347\233\256\345\211\215\350\263\207\346\226\231\344\276\206\346\272\220\357\274\232<strong className=\"text-slate-900\">{dataSourceLabel}</strong>\n                <span className=\"mx-1.5\" aria-hidden=\"true\">\302\267</span>\n                \345\205\261 <span className=\"font-mono tabular-nums font-semibold text-slate-900\">{recordCount}</span> \346\252\224\346\250\231\347\232\204\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  onReloadDefaultJson();\n                  onClose();\n                }}\n                className=\"inline-flex items-center gap-1.5 h-8 px-3 text-xs font-medium text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 rounded cursor-pointer whitespace-nowrap\"\n              >\n                <RefreshCw className=\"w-3.5 h-3.5\" aria-hidden=\"true\" />\n                <span>\351\207\215\346\226\260\350\274\211\345\205\245\351\240\220\350\250\255 stocks.json</span>\n              </button>\n            </div>\n\n            <div className=\"border border-dashed border-slate-300 bg-slate-50 rounded-md p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n              <div>\n                <p className=\"font-semibold text-slate-900\">\345\215\263\346\231\202\345\214\257\345\205\245\346\234\254\346\251\237 JSON \346\270\254\350\251\246</p>\n                <p className=\"text-slate-500 mt-0.5\">\n                  \345\217\257\347\233\264\346\216\245\351\201\270\345\217\226\346\202\250\347\224\261 Python \347\224\242\345\207\272\347\232\204 <code className=\"font-mono\">stocks.json</code> \346\252\224\346\241\210\357\274\214\345\234\250\347\200\217\350\246\275\345\231\250\344\270\255\347\253\213\345\215\263\351\240\220\350\246\275\347\257\251\351\201\270\350\210\207\346\216\222\345\272\217\343\200\202\n                </p>\n              </div>\n              <input\n                ref={fileInputRef}\n                type=\"file\"\n                accept=\".json,application/json\"\n                onChange={handleFileChange}\n                className=\"hidden\"\n              />\n              <button\n                type=\"button\"\n                onClick={() => fileInputRef.current?.click()}\n                className=\"inline-flex items-center justify-center gap-1.5 h-9 px-4 text-xs font-semibold text-white bg-[#1B365D] hover:bg-[#132847] rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n              >\n                <Upload className=\"w-3.5 h-3.5\" aria-hidden=\"true\" />\n                <span>\351\201\270\346\223\207 JSON \346\252\224\346\241\210</span>\n              </button>\n            </div>\n\n            {errorMsg && (\n              <p className=\"text-red-700 font-medium\" role=\"alert\">\n                {errorMsg}\n              </p>\n            )}\n          </div>\n\n          {/* Python Auto-Update Example */}\n          <div className=\"space-y-2\">\n            <div className=\"flex items-center justify-between\">\n              <p className=\"font-semibold text-slate-900\">\n                Python \346\257\217\346\227\245\350\246\206\345\257\253\347\257\204\344\276\213\357\274\210\345\260\215\346\207\211 23 \345\200\213\350\241\250\346\240\274\346\254\204\344\275\215\357\274\211\n              </p>\n              <button\n                type=\"button\"\n                onClick={handleCopySnippet}\n                className=\"inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium text-slate-700 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded cursor-pointer\"\n              >\n                {copied ? (\n                  <>\n                    <Check className=\"w-3.5 h-3.5 text-emerald-700\" aria-hidden=\"true\" />\n                    <span>\345\267\262\350\244\207\350\243\275</span>\n                  </>\n                ) : (\n                  <>\n                    <Copy className=\"w-3.5 h-3.5\" aria-hidden=\"true\" />\n                    <span>\350\244\207\350\243\275\347\250\213\345\274\217\347\242\274</span>\n                  </>\n                )}\n              </button>\n            </div>\n            <p className=\"text-slate-500 leading-relaxed\">\n              \351\240\201\351\235\242\350\274\211\345\205\245\346\231\202\346\234\203\350\207\252\345\213\225\345\220\221\345\220\214\347\233\256\351\214\204\347\232\204 <code className=\"font-mono text-slate-800\">/stocks.json</code> \350\256\200\345\217\226\350\263\207\346\226\231\357\274\210\345\220\214\346\231\202\344\272\246\345\234\250\347\250\213\345\274\217\347\242\274\344\270\255\344\277\235\347\225\231\347\215\250\347\253\213\347\232\204 <code className=\"font-mono text-slate-800\">stocksData</code> \351\231\243\345\210\227\344\275\234\347\202\272\345\202\231\346\217\264\357\274\211\343\200\202ETF \350\213\245\347\204\241 EPS \346\210\226\346\234\254\347\233\212\346\257\224\357\274\214\346\225\270\345\200\274\346\254\204\344\275\215\345\241\253\345\205\245 <code className=\"font-mono text-slate-800\">null</code>\343\200\201\346\227\245\346\234\237\345\241\253\345\205\245 <code className=\"font-mono text-slate-800\">&quot;-&quot;</code> \345\215\263\345\217\257\343\200\202\n            </p>\n            <pre className=\"bg-slate-900 text-slate-100 font-mono text-[11px] leading-relaxed p-3.5 rounded-md overflow-x-auto\">\n              <code>{PYTHON_SNIPPET}</code>\n            </pre>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/DataGuideModal.tsx"
        }
        overwrite: true
      }
    }
